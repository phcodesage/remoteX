# Control server
REMOTE_SERVER_URL=https://remotex.chat-x.site
REMOTE_AUTOSTART_SERVER=false
REMOTE_PORT=8080
REMOTE_DATABASE_URL=sqlite:///./remote_support.sqlite3
REMOTE_JWT_SECRET=replace-with-a-long-random-secret
REMOTE_JWT_TTL_MINUTES=30
REMOTE_PAIRING_TTL_MINUTES=10
# Legacy local account compatibility; attended pairing does not use this.
REMOTE_LOCAL_AUTH_ENABLED=true

# Cloudflare Tunnel remains the HTTPS/WSS route to FastAPI; it is not a
# WebRTC media relay by itself.
REMOTE_STUN_URLS=stun:stun.cloudflare.com:3478
REMOTE_TURN_URLS=
REMOTE_TURN_USERNAME=
REMOTE_TURN_CREDENTIAL=

# Preferred Cloudflare Realtime TURN integration. Keep the API token server-side;
# FastAPI generates short-lived client credentials from this key.
REMOTE_CLOUDFLARE_TURN_KEY_ID=
REMOTE_CLOUDFLARE_TURN_API_TOKEN=
REMOTE_CLOUDFLARE_TURN_TTL_SECONDS=3600

# Optional legacy account enrollment. Attended pairing does not require this.
REMOTE_OWNER_TOKEN=

# Optional legacy shared-account token. Leave empty for attended pairing.
REMOTE_ACCESS_TOKEN=
REMOTE_DEVICE_NAME=Remote computer
REMOTE_DEVICE_DATA_DIR=~/.python-remote

# Viewer defaults
REMOTE_VIEWER_EMAIL=
REMOTE_VIEWER_PASSWORD=
